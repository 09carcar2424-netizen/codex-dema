{
  "name": "wordpress-site-automation-hub",
  "version": "0.1.0",
  "private": true,
  "description": "Dashboard and automation blueprint for managing multilingual WordPress sites, landing pages, and publishing workflows.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite --host 127.0.0.1",
    "dev:api": "node server/index.js",
    "start": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "db:schema": "psql \"$DATABASE_URL\" -f database/schema.sql",
    "import:domains": "node scripts/import-domain-portfolio.mjs",
    "sync:domain-inventory": "node scripts/sync-domain-inventory.mjs",
    "sync:sitemaps": "node scripts/sync-sitemap-submissions.mjs",
    "sync:siteops-readiness": "node scripts/sync-siteops-readiness.mjs",
    "report:siteops-readiness": "node scripts/report-siteops-readiness.mjs",
    "submit:sitemaps:google": "node scripts/submit-google-sitemaps.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "dotenv": "^17.4.2",
    "lucide-react": "^0.561.0",
    "pg": "^8.20.0",
    "punycode": "^2.3.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "vite": "^7.2.7"
  }
}
